rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null && 
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) ||
         request.auth.token.email == 'zenvorashoop@gmail.com' ||
         request.auth.token.email == 'admin@zenvora.com' ||
         request.auth.token.email == 'g.ishaq2007@gmail.com');
    }

    // Products collection:
    // Anyone can read products and stock levels to view inventory and checkout.
    // Admins can create, update, and delete products.
    // Customers checking out or cancelling need to update stock atomically via transactions.
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || !exists(/databases/$(database)/documents/products/$(productId));
      allow delete: if isAdmin();
      // Allow stock and price update
      allow update: if true;
    }

    // Orders collection:
    // Anyone can create an order with valid data.
    // Anyone can read an order if they know the order ID (e.g. for tracking status or cancellation).
    // Updating order status allowed for admin stock control and customer cancellations.
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.status == 'Pending' &&
                       request.resource.data.orderId == orderId;
      allow update: if true;
      allow delete: if isAdmin();
    }

    // Admin Users collection:
    // Authenticated admin can read/write their admin settings
    match /adminUsers/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Members collection:
    // Membership code acts as document identifier and lookup key.
    // Customers can get their own membership profile and purchases.
    // Admin Stock panel can manage members and purchases.
    match /members/{memberCode} {
      allow read, write: if true;

      match /purchases/{purchaseId} {
        allow read, write: if true;
      }
    }
  }
}
